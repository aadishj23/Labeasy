# Copy to .env and fill in. Keep ONE space-free "KEY=value" per line and avoid
# surrounding quotes — that format works for both dotenv (next) and Docker's
# strict `--env-file` parser.

# ---------- Database (PostgreSQL) ----------
DATABASE_URL=postgresql://user:password@localhost:5432/labeasy

# ---------- Auth ----------
# Secret for signing session JWTs. Use a long random string.
JWT_SECRET=change-me-to-a-long-random-string

# ---------- Admin ----------
# Reserved admin account email (cannot be used for patient/lab signup). The
# admin password lives bcrypt-hashed in the DB "Admin" table; reset via the
# admin page's OTP forgot-password flow (code sent to this address).
ADMIN_EMAIL=admin@example.com

# ---------- URLs ----------
# Public site URL — used for sitemap.xml / robots.txt / canonical URLs and
# links in transactional emails.
NEXT_PUBLIC_SITE_URL=https://labeasy.example.com

# ---------- Email (Resend) ----------
RESEND_API_KEY=
# Verified sender, e.g. Labeasy <noreply@yourdomain.com>
RESEND_FROM_EMAIL=

# ---------- Payments (Razorpay) ----------
RAZORPAY_API_KEY=
RAZORPAY_API_SECRET=

# ---------- File storage (Cloudinary) ----------
# Full URL form: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=

# ---------- AI (Google Gemini) ----------
GEMINI_API_KEY=
# Optional — default model for non-Phase-6 calls (Phase 6 uses gemini-2.5-flash).
GEMINI_MODEL=gemini-2.0-flash

# ---------- Cache (Upstash Redis, REST) ----------
# From the Upstash console. Caching is optional — the app runs fine without it.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------- Cron ----------
# Shared secret for POST /api/v1/reminders/run (re-test reminder emails). Send
# it as the `x-cron-secret` header from your scheduler.
CRON_SECRET=
