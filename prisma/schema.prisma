// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PATIENT
  LAB
  ADMIN
}

enum LabStatus {
  PENDING
  VERIFIED
  SUSPENDED
}

enum CollectionType {
  HOME
  LAB_VISIT
}

enum OrderStatus {
  PLACED
  CONFIRMED
  SAMPLE_COLLECTED
  PROCESSING
  REPORT_READY
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  CREATED
  PAID
  FAILED
  REFUNDED
}

enum ReportStatus {
  PENDING
  READY
}

enum CouponType {
  PERCENT
  FLAT
}

model User {
  id             String     @id @default(dbgenerated())
  password       String
  name           String
  email          String     @unique
  phone          String     @unique
  role           Role       @default(PATIENT)
  dob            DateTime?
  gender         String?
  email_verified Boolean    @default(false)
  insured        Boolean    @default(false) // referred via an insurance partner
  insurance_discount_pct Int @default(0) // extra test discount for insured users
  created_at     DateTime   @default(now())
  userTests      UserTest[]
  addresses      Address[]
  orders         Order[]
  reports        Report[]
  reviews        Review[]
  insuranceLeads InsuranceLead[]
  healthSummary  HealthSummary?
  testReminders  TestReminder[]
  appointments   Appointment[]
  policyPurchases PolicyPurchase[]
  vendorPatients VendorPatient[]
}

model VendorPatient {
  id          String    @id @default(cuid())
  vendor_type String // LAB | DOCTOR
  vendor_id   String
  name        String
  phone       String
  gender      String? // MALE | FEMALE | OTHER (required on manual add)
  dob         DateTime? // required on manual add
  user_id     String? // linked Labeasy user (matched by phone)
  source      String    @default("MANUAL") // MANUAL | PLATFORM
  created_at  DateTime  @default(now())
  user        User?     @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@unique([vendor_type, vendor_id, phone])
  @@index([vendor_type, vendor_id])
  @@index([user_id])
}

model TestReminder {
  id               String    @id @default(cuid())
  user_id          String
  test_name        String
  interval_days    Int
  due_at           DateTime
  active           Boolean   @default(true)
  last_notified_at DateTime?
  created_at       DateTime  @default(now())
  user             User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([due_at])
}

model HealthSummary {
  id                   String   @id @default(cuid())
  user_id              String   @unique
  summary              String // plain-language overview
  highlights           Json     @default("[]") // [{ name, status, note }]
  suggested_specialties String[] @default([])
  input_hash           String // hash of the analyte inputs (cache key)
  generated_at         DateTime @default(now()) @updatedAt
  user                 User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model InsuranceCompany {
  id          String          @id @default(cuid())
  name        String          @unique
  email       String          @unique
  password    String
  logo_url    String?
  description String?
  license_url String?
  status      String          @default("PENDING") // PENDING | APPROVED | REJECTED
  active      Boolean         @default(true)
  created_at  DateTime        @default(now())
  plans       InsurancePlan[]
  leads       InsuranceLead[]
  purchases   PolicyPurchase[]

  @@index([status])
}

model InsurancePlan {
  id                  String           @id @default(cuid())
  company_id          String
  name                String
  description         String // detailed plan description
  price               Int // paise
  commission_pct      Int              @default(0)
  commission_approved Boolean          @default(false) // admin must approve before it's sellable
  active              Boolean          @default(true)
  created_at          DateTime         @default(now())
  company             InsuranceCompany @relation(fields: [company_id], references: [id], onDelete: Cascade)
  purchases           PolicyPurchase[]

  @@index([company_id])
}

model PolicyPurchase {
  id                  String           @id @default(cuid())
  plan_id             String
  company_id          String
  user_id             String
  amount              Int // gross paise paid by the patient
  commission          Int              @default(0) // paise — platform's cut
  coupon_id           String? // applied coupon
  platform_discount   Int              @default(0) // discount funded by Labeasy (admin coupon)
  status              String           @default("PLACED") // PLACED | CONFIRMED
  provider_order_id   String?
  provider_payment_id String?
  created_at          DateTime         @default(now())
  plan                InsurancePlan    @relation(fields: [plan_id], references: [id])
  company             InsuranceCompany @relation(fields: [company_id], references: [id], onDelete: Cascade)
  user                User             @relation(fields: [user_id], references: [id])

  @@index([company_id])
  @@index([user_id])
}

model Doctor {
  id          String   @id @default(cuid())
  name        String
  email       String   @unique
  password    String
  specialty   String // chosen from a fixed list
  pincode     String
  city        String?
  clinic      String?
  phone       String?
  fee         Int? // consultation fee (rupees)
  description String?
  license_url String?
  status       String   @default("PENDING") // PENDING | APPROVED | REJECTED
  active       Boolean  @default(true)
  rating_avg   Float    @default(0)
  rating_count Int      @default(0)
  created_at   DateTime @default(now())
  slots        DoctorSlot[]
  appointments Appointment[]

  @@index([specialty])
  @@index([status])
}

model DoctorSlot {
  id           String        @id @default(cuid())
  doctor_id    String
  start_at     DateTime
  end_at       DateTime
  capacity     Int           @default(1)
  booked_count Int           @default(0)
  active       Boolean       @default(true)
  created_at   DateTime      @default(now())
  doctor       Doctor        @relation(fields: [doctor_id], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@index([doctor_id])
}

model Appointment {
  id                  String      @id @default(cuid())
  doctor_id           String
  user_id             String? // null for manual (off-platform) bookings
  patient_name        String? // for manual bookings
  patient_phone       String?
  source              String      @default("PLATFORM") // PLATFORM | MANUAL
  paid_status         String? // PAID | UNPAID | PARTIAL (manual bookings)
  amount_paid         Int         @default(0) // paise collected off-platform
  coupon_id           String? // applied coupon
  platform_discount   Int         @default(0) // discount funded by Labeasy (admin coupon)
  slot_id             String?
  scheduled_at        DateTime
  fee                 Int // paise — total paid by the patient
  platform_fee        Int         @default(0) // paise
  status              String      @default("PLACED") // PLACED | CONFIRMED | COMPLETED | CANCELLED
  provider_order_id   String?
  provider_payment_id String?
  created_at          DateTime    @default(now())
  doctor              Doctor      @relation(fields: [doctor_id], references: [id], onDelete: Cascade)
  user                User?       @relation(fields: [user_id], references: [id])
  slot                DoctorSlot? @relation(fields: [slot_id], references: [id])

  @@index([doctor_id])
  @@index([user_id])
}

model InsuranceLead {
  id           String           @id @default(cuid())
  company_id   String
  plan_id      String?
  user_id      String?
  status       String           @default("CLICKED") // CLICKED | CONVERTED | REJECTED
  created_at   DateTime         @default(now())
  converted_at DateTime?
  company      InsuranceCompany @relation(fields: [company_id], references: [id], onDelete: Cascade)
  user         User?            @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([company_id])
  @@index([user_id])
}

model Address {
  id         String  @id @default(cuid())
  user_id    String
  label      String?
  line1      String
  line2      String?
  city       String
  state      String
  pincode    String
  lat        Float?
  lng        Float?
  is_default Boolean @default(false)
  user       User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  orders     Order[]

  @@index([user_id])
}

model Lab {
  id              String        @id @default(dbgenerated())
  lab_name        String        @unique
  owner_name      String
  phone           String        @unique
  email           String        @unique
  password        String
  license_no      String        @unique
  gst_no          String        @unique
  address         String
  city            String
  state           String
  pincode         String
  lat             Float?
  lng             Float?
  slug            String?       @unique
  status          LabStatus     @default(PENDING)
  home_collection Boolean       @default(false)
  hours           Json?
  accreditations  String[]      @default([])
  logo_url        String?
  rating_avg      Float         @default(0)
  rating_count    Int           @default(0)
  created_at      DateTime      @default(now())
  labTests        LabTest[]
  userTests       UserTest[]
  documents       LabDocument[]
  slots           Slot[]
  orders          Order[]
  packages        Package[]
}

model LabDocument {
  id         String   @id @default(cuid())
  lab_id     String
  type       String // license | gst | nabl | other
  url        String
  verified   Boolean  @default(false)
  created_at DateTime @default(now())
  lab        Lab      @relation(fields: [lab_id], references: [id], onDelete: Cascade)

  @@index([lab_id])
}

model Tests {
  id               String      @id @default(dbgenerated())
  test_name        String      @unique
  test_description String
  category         String?
  sample_type      String?
  fasting_required Boolean     @default(false)
  turnaround_hours Int         @default(12)
  parameters       Json?
  slug             String?     @unique
  aliases          String[]    @default([])
  labTests         LabTest[]
  userTests        UserTest[]
  orderItems       OrderItem[]
  packageItems     PackageItem[]
}

model LabTest {
  lab_id                String
  lab_name              String
  test_id               String
  test_price            String
  home_collection_price String?
  turnaround_hours      Int?
  active                Boolean @default(true)
  test_name             String
  test_description      String
  lab                   Lab     @relation(fields: [lab_id], references: [id], onDelete: Cascade)
  test                  Tests   @relation(fields: [test_id], references: [id], onDelete: Cascade)

  @@id([lab_id, test_id])
}

model UserTest {
  id            String   @id @default(dbgenerated())
  user_id       String
  lab_id        String
  test_id       String
  purchase_date DateTime @default(now())
  test_price    String
  drive_link    String?
  user          User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  lab           Lab      @relation(fields: [lab_id], references: [id], onDelete: Cascade)
  test          Tests    @relation(fields: [test_id], references: [id], onDelete: Cascade)

  @@unique([user_id, test_id, lab_id])
}

model Slot {
  id       String   @id @default(cuid())
  lab_id   String
  start    DateTime
  end      DateTime
  capacity Int      @default(1)
  booked   Int      @default(0)
  lab      Lab      @relation(fields: [lab_id], references: [id], onDelete: Cascade)
  orders   Order[]

  @@index([lab_id, start])
}

model Order {
  id              String         @id @default(cuid())
  user_id         String? // null for manual (off-platform) orders
  lab_id          String
  status          OrderStatus    @default(PLACED)
  collection_type CollectionType @default(LAB_VISIT)
  address_id      String?
  slot_id         String?
  scheduled_at    DateTime?
  subtotal        Int
  discount        Int            @default(0)
  platform_discount Int          @default(0) // discount funded by Labeasy (admin coupon)
  platform_fee    Int            @default(0)
  total           Int
  coupon_id       String?
  cancel_reason   String?
  source          String         @default("PLATFORM") // PLATFORM | MANUAL
  patient_name    String? // manual orders
  patient_phone   String?
  paid_status     String? // PAID | UNPAID | PARTIAL (manual orders)
  amount_paid     Int            @default(0)
  created_at      DateTime       @default(now())
  updated_at      DateTime       @updatedAt
  user            User?          @relation(fields: [user_id], references: [id])
  lab             Lab            @relation(fields: [lab_id], references: [id])
  address         Address?       @relation(fields: [address_id], references: [id])
  slot            Slot?          @relation(fields: [slot_id], references: [id])
  items           OrderItem[]
  payment         Payment?
  reports         Report[]

  @@index([user_id])
  @@index([lab_id])
}

model OrderItem {
  id         String   @id @default(cuid())
  order_id   String
  kind       String   @default("TEST") // TEST | PACKAGE
  test_id    String?
  package_id String?
  test_name  String
  price      Int
  order      Order    @relation(fields: [order_id], references: [id], onDelete: Cascade)
  test       Tests?   @relation(fields: [test_id], references: [id])
  package    Package? @relation(fields: [package_id], references: [id])
  report     Report?

  @@index([order_id])
}

model Payment {
  id                  String        @id @default(cuid())
  order_id            String        @unique
  provider            String        @default("razorpay")
  provider_order_id   String?
  provider_payment_id String?
  amount              Int
  status              PaymentStatus @default(CREATED)
  created_at          DateTime      @default(now())
  order               Order         @relation(fields: [order_id], references: [id], onDelete: Cascade)
}

model Report {
  id            String       @id @default(cuid())
  order_id      String
  order_item_id String?      @unique
  user_id       String
  lab_id        String
  test_id       String?
  file_url      String?
  results       Json?
  ai_summary    Json? // cached per-report AI summary
  status        ReportStatus @default(PENDING)
  share_token   String?      @unique
  created_at    DateTime     @default(now())
  order         Order        @relation(fields: [order_id], references: [id], onDelete: Cascade)
  order_item    OrderItem?   @relation(fields: [order_item_id], references: [id])
  user          User         @relation(fields: [user_id], references: [id])

  @@index([user_id])
  @@index([order_id])
}

model Review {
  id            String   @id @default(cuid())
  user_id       String?
  reviewer_name String?
  target_type   String // LAB | DOCTOR
  target_id     String
  order_id      String?
  rating        Int
  comment       String?
  status        String   @default("published")
  created_at    DateTime @default(now())
  user          User?    @relation(fields: [user_id], references: [id])

  @@unique([user_id, target_type, target_id])
  @@index([target_type, target_id])
}

model Admin {
  id         String   @id @default(cuid())
  email      String   @unique
  password   String
  created_at DateTime @default(now())
}

model Otp {
  id         String   @id @default(cuid())
  email      String
  code_hash  String
  purpose    String
  expires_at DateTime
  created_at DateTime @default(now())

  @@index([email, purpose])
}

model ProfileChangeRequest {
  id          String   @id @default(cuid())
  vendor_type String // LAB | DOCTOR | INSURANCE
  vendor_id   String
  changes     Json
  status      String   @default("PENDING") // PENDING | APPROVED | REJECTED
  reviewed_by String?
  created_at  DateTime @default(now())

  @@index([vendor_type, vendor_id])
  @@index([status])
}

model Package {
  id          String        @id @default(cuid())
  lab_id      String
  name        String
  slug        String        @unique
  description String?
  price       Int // rupees
  mrp         Int? // rupees (strike-through)
  category    String?
  active      Boolean       @default(true)
  created_at  DateTime      @default(now())
  lab         Lab           @relation(fields: [lab_id], references: [id], onDelete: Cascade)
  items       PackageItem[]
  orderItems  OrderItem[]

  @@index([lab_id])
}

model PackageItem {
  id         String  @id @default(cuid())
  package_id String
  test_id    String
  package    Package @relation(fields: [package_id], references: [id], onDelete: Cascade)
  test       Tests   @relation(fields: [test_id], references: [id])

  @@unique([package_id, test_id])
  @@index([package_id])
}

model Coupon {
  id             String             @id @default(cuid())
  owner_type     String // LAB | DOCTOR | INSURANCE | ADMIN
  owner_id       String // "" for ADMIN coupons
  scope          String? // ADMIN coupons: ALL | LAB | DOCTOR | INSURANCE
  code           String // stored uppercase
  type           CouponType         @default(PERCENT)
  value          Int // percent (e.g. 20) or flat rupees
  max_discount   Int? // cap in rupees (for percent coupons)
  min_order      Int? // minimum cart subtotal in rupees
  starts_at      DateTime?
  ends_at        DateTime?
  usage_limit    Int? // total redemptions allowed
  per_user_limit Int? // redemptions allowed per user
  used_count     Int                @default(0)
  active         Boolean            @default(true)
  created_at     DateTime           @default(now())
  redemptions    CouponRedemption[]

  @@unique([owner_type, owner_id, code])
  @@index([owner_type, owner_id])
}

model CouponRedemption {
  id         String   @id @default(cuid())
  coupon_id  String
  ref_id     String   @unique // order / appointment / policy id
  user_id    String
  created_at DateTime @default(now())
  coupon     Coupon   @relation(fields: [coupon_id], references: [id], onDelete: Cascade)

  @@index([coupon_id])
  @@index([user_id])
}

model WalletEntry {
  id          String   @id @default(cuid())
  owner_type  String // LAB | DOCTOR | INSURANCE
  owner_id    String
  amount      Int // paise, signed: + = company owes vendor, - = vendor owes company
  type        String // ORDER_EARNING | PLATFORM_FEE | SPONSORSHIP | TOPUP | PAYOUT | ADJUSTMENT
  description String?
  ref_id      String? // links to order/period/sponsorship/payout; also used for idempotency
  created_at  DateTime @default(now())

  @@index([owner_type, owner_id])
  @@index([ref_id])
}

model SponsoredListing {
  id                  String    @id @default(cuid())
  owner_type          String // LAB | DOCTOR | INSURANCE
  owner_id            String
  scope               String    @default("DIRECTORY") // LAB: EVERYWHERE|DIRECTORY|TESTS · others: FEATURED
  test_ids            String[]  @default([]) // targeted tests when scope = TESTS
  amount              Int       @default(0) // paise — total price
  wallet_applied      Int       @default(0) // paise paid from wallet balance
  starts_at           DateTime?
  ends_at             DateTime?
  active              Boolean   @default(false) // activated on payment
  provider_order_id   String?
  provider_payment_id String?
  created_at          DateTime  @default(now())

  @@index([owner_type, owner_id])
}

